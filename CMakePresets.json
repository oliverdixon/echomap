{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "native",
      "hidden": true,
      "inherits": "default",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "wasm",
      "hidden": true,
      "inherits": "default",
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "app",
      "hidden": true,
      "cacheVariables": {
        "ECHOMAP_BUILD_APPLICATION": true,
        "ECHOMAP_BUILD_TESTS": false,
        "ECHOMAP_BUILD_DOCUMENTATION": false
      }
    },
    {
      "name": "test",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_INIT": "-fprofile-instr-generate -fcoverage-mapping",
        "ECHOMAP_BUILD_APPLICATION": false,
        "ECHOMAP_BUILD_TESTS": true,
        "ECHOMAP_BUILD_DOCUMENTATION": false
      }
    },

    {
      "name": "native-debug-app",
      "inherits": [
        "native",
        "debug",
        "app"
      ],
      "binaryDir": "${sourceDir}/cmake-build-native-debug"
    },
    {
      "name": "native-release-app",
      "inherits": [
        "native",
        "release",
        "app"
      ],
      "binaryDir": "${sourceDir}/cmake-build-native-release"
    },
    {
      "name": "native-debug-test",
      "inherits": [
        "native",
        "debug",
        "test"
      ],
      "binaryDir": "${sourceDir}/cmake-build-native-debug-test"
    },
    {
      "name": "native-release-test",
      "inherits": [
        "native",
        "release",
        "test"
      ],
      "binaryDir": "${sourceDir}/cmake-build-native-release-test"
    },
    {
      "name": "wasm-debug-app",
      "inherits": [
        "wasm",
        "debug",
        "app"
      ],
      "binaryDir": "${sourceDir}/cmake-build-wasm-debug"
    },
    {
      "name": "wasm-release-app",
      "inherits": [
        "wasm",
        "release",
        "app"
      ],
      "binaryDir": "${sourceDir}/cmake-build-wasm-release"
    },
    {
      "name": "documentation",
      "generator": "Ninja",
      "cacheVariables": {
        "ECHOMAP_BUILD_APPLICATION": false,
        "ECHOMAP_BUILD_TESTS": false,
        "ECHOMAP_BUILD_DOCUMENTATION": true
      },
      "binaryDir": "${sourceDir}/docs/out"
    }
  ]
}
