{
  "version": 6,
  "configurePresets": [
    {
      "name": "local-toolchain",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/path/to/clang",
        "CMAKE_CXX_COMPILER": "/path/to/clang++",
        "CMAKE_LINKER_TYPE": "LLD"
      }
    },
    {
      "name": "local-node",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CROSSCOMPILING_EMULATOR": "node"
      }
    },
    {
      "name": "local-environment",
      "hidden": true,
      "environment": {
        "VCPKG_ROOT": "/path/to/vcpkg",
        "EMSDK": "/path/to/emsdk"
      }
    },
    {
      "name": "native-debug-local",
      "inherits": [
        "native-debug",
        "local-toolchain",
        "local-environment"
      ]
    },
    {
      "name": "native-release-local",
      "inherits": [
        "native-release",
        "local-toolchain",
        "local-environment"
      ]
    },
    {
      "name": "native-debug-test-local",
      "inherits": [
        "native-debug-test",
        "local-toolchain",
        "local-environment"
      ]
    },
    {
      "name": "native-release-test-local",
      "inherits": [
        "native-release-test",
        "local-toolchain",
        "local-environment"
      ]
    },
    {
      "name": "wasm-debug-local",
      "inherits": [
        "wasm-debug",
        "local-environment",
        "local-node"
      ]
    },
    {
      "name": "wasm-release-local",
      "inherits": [
        "wasm-release",
        "local-environment",
        "local-node"
      ]
    }
  ]
}
